{
  "id": "golden-hour-dks",
  "name": "Golden Hour",
  "short_name": "Golden Hour",
  "description": "Instantly see if it's golden or blue hour where you are, with sunrise/sunset times and a weather-risk warning for photographers.",
  "start_url": "/golden-hour",
  "scope": "/golden-hour/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#14161a",
  "theme_color": "#14161a",
  "icons": [
    {
      "src": "images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/icon-mascable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots" : [
    {
      "src": "images/ss/ss1.jpg",
      "sizes": "1280x720",
      "type": "image/jpg",
      "form_factor": "wide",
      "platform": "windows"
    },
    {
      "src": "images/ss/ss2.jpg",
      "sizes": "1280x720",
      "type": "image/jpg",
      "form_factor": "wide",
      "platform": "windows"
    },
    {
